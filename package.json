{
  "name": "annex21",
  "version": "0.1.0",
  "private": true,
  "description": "Annex21 — SaaS NIS2-native, data in-EU (MVP monorepo)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @annex21/web dev",
    "dev:api": "pnpm --filter @annex21/api dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
