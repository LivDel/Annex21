# =============================================================================
# Annex21 MVP — variables d'environnement (AUCUN secret de production ici)
# Copier vers .env en local. RG-10 : toute donnée tenant reste in-EU.
# =============================================================================

NODE_ENV=development

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Token stub côté web (dev only, aligné AUTH_STUB_TOKEN)
NEXT_PUBLIC_AUTH_STUB_TOKEN=annex21-dev-stub

# --- API (NestJS) ---
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Auth stub : UNIQUEMENT si AUTH_ALLOW_STUB=true ET NODE_ENV=development
AUTH_ALLOW_STUB=true
AUTH_STUB_TOKEN=annex21-dev-stub
SESSION_COOKIE_NAME=annex21_session
# Origine web (redirects magic-link, allowlist)
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
# Allowlist redirects post-verify AND connector connect redirectUri (open-redirect hardening).
# Comma-separated origins. Defaults: localhost:3000/3001 + NEXT_PUBLIC_WEB_ORIGIN / API_CORS_ORIGIN / API_PUBLIC_URL.
# Invalid client redirect → /app/onboarding (auth) or API OAuth callback (connectors).
AUTH_REDIRECT_ALLOWLIST=http://localhost:3000

# --- Postgres (docker-compose, région EU obligatoire en prod) ---
# DATABASE_URL=postgresql://annex21:changeme_local_only@localhost:5432/annex21
# Si DATABASE_URL absent, POSTGRES_* est utilisé pour construire l'URL.
# Sans DB joignable en dev → fallback in-memory (warning console).
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=annex21
POSTGRES_USER=annex21
POSTGRES_PASSWORD=changeme_local_only

# --- Redis (sessions / magic-links / files d’alertes SLA — in-EU) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Brevo EU (magic-link email). Si manquant en dev → stub log. ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Connecteurs ---
# Clé AES-GCM 32 bytes hex (64 chars) ou passphrase (dérivée SHA-256)
CONNECTOR_SECRETS_KEY=
# Microsoft Entra — scopes: openid offline_access User.Read AuditLog.Read.All
# JAMAIS Directory.Read.All (UX : « lecture journaux d’audit »)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AWS AssumeRole (pas OAuth user)
AWS_EXTERNAL_ID_PREFIX=annex21
# Forcer sync vide pour tester CONNECTOR_NO_DATA_EXPORTED
CONNECTOR_SYNC_EMPTY=false

# --- MinIO (preuves / evidence — bucket in-EU, jamais exposé au Trust public) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=annex21
MINIO_ROOT_PASSWORD=changeme_local_only
MINIO_BUCKET=annex21-evidence
# Région logique MinIO — documenter eu-west / eu-central en prod, jamais us-*.
MINIO_REGION=eu-west-1

# --- Résidence des données ---
# DATA_RESIDENCY=EU  → Postgres, Redis, MinIO, backups et logs applicatifs sensibles
# doivent rester dans l'Union européenne (RG-10). Ne pas pointer vers un cloud US.
DATA_RESIDENCY=EU

# --- Assessment / Playbooks (V1) ---
# Store : Postgres si DATABASE_URL / POSTGRES_* joignable, sinon in-memory (dev, loggé).
# Migration auto au boot API, ou manuelle :
#   pnpm --filter @annex21/api migrate
#   # equiv: psql $DATABASE_URL -f infra/migrations/001_assessment_playbooks.sql
# Routes /assessments /controls /playbooks /incidents /audit-events : AppAuthGuard uniquement.
# assertEuResidency() au boot API (DATA_RESIDENCY=EU, refuse us-* / hors UE).

# --- EU residency enforcement ---
# assertEuResidency() au boot API : refuse DATA_RESIDENCY hors EU / régions us-*.
# FORCE_EU_RESIDENCY_WARN=1 : warning au lieu de throw — DEV ONLY.
# JAMAIS activer en production : le flag est ignoré et le boot fail-closed (RG-10).
# FORCE_EU_RESIDENCY_WARN=

# --- Stripe ACV billing (sales-led, secrets EU only — RG-10 / RG-16) ---
# JAMAIS en NEXT_PUBLIC_* : STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_ID_*.
# Uniquement côté API Nest (server). Checkout Sessions redirect — Elements optionnel.
# DATA_RESIDENCY=EU : Postgres / Redis / MinIO restent in-EU ; Stripe est processeur de paiement
# (PCI) — ne pas stocker de PAN ; webhooks signés (Stripe-Signature + raw body).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# 3 Price ACV devis signé (sales-led) — pas un seul STRIPE_PRICE_ID
STRIPE_PRICE_ID_10K=price_replace_me_acv_10k_eur
STRIPE_PRICE_ID_20K=price_replace_me_acv_20k_eur
STRIPE_PRICE_ID_30K=price_replace_me_acv_30k_eur
# Fee onboarding one-shot (optionnel) — Price Stripe si dispo, sinon price_data + STRIPE_ONBOARDING_FEE_CENTS
STRIPE_PRICE_ID_ONBOARDING=price_replace_me_onboarding_oneshot_eur
# Fee onboarding fallback (centimes EUR, plage 500000–1500000 = 5–15 k€) — défaut 1000000
STRIPE_ONBOARDING_FEE_CENTS=1000000
# Publishable key ONLY if Elements needed (Checkout redirect usually does not need it)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
