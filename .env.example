# Annex21 local env — copy to .env and adjust
# EU data residency: keep all services in EU regions only.

# --- Apps ---
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001

# --- Postgres (EU) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=annex21
POSTGRES_USER=annex21
POSTGRES_PASSWORD=annex21_dev_change_me
DATABASE_URL=postgresql://annex21:annex21_dev_change_me@localhost:5432/annex21

# --- Redis (EU) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO / S3-compatible (EU object storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=annex21minio
MINIO_SECRET_KEY=annex21minio_dev_change_me
MINIO_BUCKET=annex21-evidence
MINIO_USE_SSL=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=annex21minio
S3_SECRET_ACCESS_KEY=annex21minio_dev_change_me
S3_BUCKET=annex21-evidence

# --- Auth stubs (MVP) ---
AUTH_MAGIC_LINK_SECRET=dev_magic_link_secret_change_me
AUTH_JWT_SECRET=dev_jwt_secret_change_me
AUTH_COOKIE_NAME=annex21_session

# --- Trust / evidence ---
EVIDENCE_PRIVATE_ONLY=true
TRUST_PUBLIC_REQUIRES_PUBLISH=true
EU_DATA_RESIDENCY=true
