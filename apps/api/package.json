{
  "name": "@annex21/api",
  "version": "0.1.0",
  "private": true,
  "description": "Annex21 NestJS API — magic-link auth, sessions Redis, connectors, trust, evidence",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:sql": "echo Use: psql \\$DATABASE_URL -f ../../infra/migrations/001_assessment_playbooks.sql"
  },
  "dependencies": {
    "@annex21/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}
